# Put this map inside nginx's http context (outside the server block).
map $http_upgrade $stow_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name stow.example.com;

    # Use the certificate and key for your browser-facing hostname.
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;

    client_max_body_size 20m;

    location / {
        # If nginx runs elsewhere, replace 127.0.0.1 with the dev machine's LAN IP.
        # Use port 3001 instead to serve Stow's production build.
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $stow_connection_upgrade;
        proxy_set_header X-Forwarded-Proto $scheme;
        # For STOW_AUTH_MODE=proxy, use your authentication integration's verified
        # identity variable here. $remote_user works with nginx HTTP authentication;
        # auth_request/OIDC setups must use their authenticated response variable.
        # Never copy an incoming client X-Auth-User header.
        # proxy_set_header X-Auth-User $remote_user;
        # Overwrite this header with the same private value as STOW_PROXY_SECRET.
        # proxy_set_header X-Stow-Proxy-Secret "a-random-secret-of-at-least-32-characters";
        proxy_read_timeout 3600s;
    }
}
