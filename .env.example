# Copy to ../.env; private configuration stays outside the source checkout.
STOW_AUTH_MODE=password
STOW_PASSWORD=replace-with-your-own-long-password
# Set this when accessing development through an HTTPS reverse proxy.
# STOW_ORIGIN=https://stow.example.com
# Persistent data must stay outside the checkout and ../build/.
# DATA_DIR=/path/to/persistent/stow-data
